{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Brokenwatch24/keyhalo/main/community/schemas/catalog.schema.json",
  "title": "KeyHalo community catalog index",
  "description": "community/index.json, generated by scripts/build-index.mjs. Mirrors CatalogIndex in src/core/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "repo", "entries"],
  "properties": {
    "$schema": { "$ref": "defs.schema.json#/$defs/schemaRef" },
    "generated": { "type": "string", "format": "date-time" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "path"],
      "properties": {
        "kind": { "enum": ["device", "profile", "keymap", "effect", "typing"] },
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string", "pattern": "^community/" },
        "preview": { "type": "string" },
        "devices": { "type": "array", "items": { "type": "string" } },
        "apps": { "type": "array", "items": { "type": "string" } },
        "updated": { "type": "string", "format": "date-time" },
        "status": { "$ref": "defs.schema.json#/$defs/supportStatus" }
      }
    }
  }
}
