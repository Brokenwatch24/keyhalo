{
  "$schema": "../schemas/keymap.schema.json",
  "id": "obsidian",
  "name": "Obsidian",
  "description": "Default Obsidian hotkeys on Windows: navigation, tabs, search and editing. If you changed a hotkey in Obsidian, change it here too.",
  "author": "KeyHalo",
  "version": "1.0.0",
  "apps": ["Obsidian.exe"],
  "categories": {
    "Navigate": "#ffb454",
    "Tabs": "#4dd0e1",
    "Search": "#c792ea",
    "Format": "#5aa9ff",
    "Edit": "#7ee0a1",
    "View": "#9aa5b1"
  },
  "legends": [
    { "keys": ["ControlLeft", "KeyP"], "label": "Command palette", "category": "Navigate" },
    { "keys": ["ControlLeft", "KeyO"], "label": "Quick switcher", "category": "Navigate" },
    { "keys": ["ControlLeft", "KeyN"], "label": "New note", "category": "Navigate" },
    { "keys": ["AltLeft", "ArrowLeft"], "label": "Back", "category": "Navigate" },
    { "keys": ["AltLeft", "ArrowRight"], "label": "Forward", "category": "Navigate" },
    { "keys": ["ControlLeft", "KeyG"], "label": "Graph view", "category": "Navigate" },
    { "keys": ["ControlLeft", "KeyT"], "label": "New tab", "category": "Tabs" },
    { "keys": ["ControlLeft", "KeyW"], "label": "Close tab", "category": "Tabs" },
    { "keys": ["ControlLeft", "ShiftLeft", "KeyT"], "label": "Reopen closed tab", "category": "Tabs" },
    { "keys": ["ControlLeft", "Tab"], "label": "Next tab", "category": "Tabs" },
    { "keys": ["ControlLeft", "ShiftLeft", "Tab"], "label": "Previous tab", "category": "Tabs" },
    { "keys": ["ControlLeft", "ShiftLeft", "KeyF"], "label": "Search all notes", "category": "Search" },
    { "keys": ["ControlLeft", "KeyF"], "label": "Find in note", "category": "Search" },
    { "keys": ["ControlLeft", "KeyH"], "label": "Find and replace", "category": "Search" },
    { "keys": ["ControlLeft", "KeyB"], "label": "Bold", "category": "Format" },
    { "keys": ["ControlLeft", "KeyI"], "label": "Italic", "category": "Format" },
    { "keys": ["ControlLeft", "KeyK"], "label": "Insert link", "category": "Format" },
    { "keys": ["ControlLeft", "Slash"], "label": "Toggle comment", "category": "Format" },
    { "keys": ["ControlLeft", "Enter"], "label": "Toggle checkbox", "category": "Edit" },
    { "keys": ["ControlLeft", "BracketRight"], "label": "Indent", "category": "Edit" },
    { "keys": ["ControlLeft", "BracketLeft"], "label": "Unindent", "category": "Edit" },
    { "keys": ["ControlLeft", "KeyD"], "label": "Delete paragraph", "category": "Edit" },
    { "keys": ["ControlLeft", "KeyZ"], "label": "Undo", "category": "Edit" },
    { "keys": ["ControlLeft", "ShiftLeft", "KeyZ"], "label": "Redo", "category": "Edit" },
    { "keys": ["ControlLeft", "KeyE"], "label": "Edit / reading view", "category": "View" },
    { "keys": ["ControlLeft", "Comma"], "label": "Settings", "category": "View" }
  ],
  "bindings": [],
  "tags": ["notes", "writing", "productivity"]
}
