{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHalo",
  "version": "1.1.0",
  "identifier": "dev.keyhalo.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KeyHalo",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "KeyHalo HUD",
        "url": "index.html#/hud",
        "width": 440,
        "height": 150,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "KeyHalo contributors",
    "homepage": "https://github.com/Brokenwatch24/keyhalo",
    "shortDescription": "Keyboard & mouse studio",
    "longDescription": "Open-source studio for keyboards and mice: per-key RGB lighting, DPI tuning, per-app keymaps, macros, a typing trainer and community-shared profiles.",
    "copyright": "MIT License",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "keyhalo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQjJGNTFFQzY3M0Q4MTUKUldRVjJIUEdIdld5RytFWHg3TWNWcXFmcVVTSnRlb2dnejAvdVZIN2loNkdKNzltd21tWXhobGIK",
      "endpoints": [
        "https://github.com/Brokenwatch24/keyhalo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
